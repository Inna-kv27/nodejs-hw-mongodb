{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contacts API",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "API for managing contacts with user authentication, password recovery, and image uploads."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://your-deployed-app-name.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "User authentication endpoints"
    },
    {
      "name": "Contacts",
      "description": "Endpoints for managing user contacts"
    }
  ],
  "paths": {
    "/users/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user",
        "operationId": "registerUser",
        "description": "Creates a new user account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 6,
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string",
                          "example": "user@example.com"
                        },
                        "subscription": {
                          "type": "string",
                          "example": "starter"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g., validation error)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "missing required field email"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict (e.g., email already in use)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Email in use"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contacts": {
      "post": {
        "post": {
          "tags": [
            "Contacts"
          ],
          "summary": "Create a new contact",
          "operationId": "createContact",
          "description": "Create a new contact for the authenticated user.",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "name",
                    "email",
                    "phone"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "New Contact"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "example": "new.contact@example.com"
                    },
                    "phone": {
                      "type": "string",
                      "example": "111-222-3333"
                    },
                    "favorite": {
                      "type": "boolean",
                      "example": false
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Contact successfully created",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "../../components/schemas/contact.yaml"
                  }
                }
              }
            },
            "400": {
              "description": "Bad request (e.g., validation error, missing required fields)",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Missing required fields"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../components/responses/unauthorized.yaml"
            },
            "409": {
              "description": "Conflict (e.g., contact with given email already exists)",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Email in use"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts",
        "operationId": "getAllContacts",
        "description": "Retrieve a list of all contacts for the authenticated user. Supports pagination.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number for pagination"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "description": "Number of contacts per page"
          },
          {
            "in": "query",
            "name": "favorite",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter contacts by favorite status"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of contacts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contacts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/contact"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total number of contacts"
                    },
                    "page": {
                      "type": "integer",
                      "description": "Current page number"
                    },
                    "limit": {
                      "type": "integer",
                      "description": "Number of contacts per page"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "patch": {
        "patch": {
          "tags": [
            "Contacts"
          ],
          "summary": "Update a contact by ID",
          "operationId": "updateContactById",
          "description": "Update specific fields of an existing contact by its ID. Requires authentication.",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{24}$"
              },
              "description": "ID of the contact to update",
              "example": "60d5ec49f3e4e9001c8c4a4a"
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "example": "Jane Doe"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "example": "jane.doe@example.com"
                    },
                    "phone": {
                      "type": "string",
                      "example": "098-765-4321"
                    },
                    "favorite": {
                      "type": "boolean",
                      "example": true
                    }
                  },
                  "minProperties": 1,
                  "example": {
                    "favorite": true
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Contact successfully updated",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "../../components/schemas/contact.yaml"
                  }
                }
              }
            },
            "400": {
              "description": "Bad request (e.g., missing fields to update)",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Missing fields"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "../../components/responses/unauthorized.yaml"
            },
            "404": {
              "$ref": "../../components/responses/notFound.yaml"
            }
          }
        }
      },
      "delete": {
        "delete": {
          "tags": [
            "Contacts"
          ],
          "summary": "Delete a contact by ID",
          "operationId": "deleteContactById",
          "description": "Delete a specific contact by its unique identifier. Requires authentication.",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "in": "path",
              "name": "contactId",
              "required": true,
              "schema": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{24}$"
              },
              "description": "ID of the contact to delete",
              "example": "60d5ec49f3e4e9001c8c4a4a"
            }
          ],
          "responses": {
            "204": {
              "description": "No Content - Contact successfully deleted"
            },
            "401": {
              "$ref": "../../components/responses/unauthorized.yaml"
            },
            "404": {
              "$ref": "../../components/responses/notFound.yaml"
            }
          }
        }
      },
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get a single contact by ID",
        "operationId": "getContactById",
        "description": "Retrieve a specific contact by its unique identifier. Requires authentication.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$"
            },
            "description": "ID of the contact to retrieve",
            "example": "60d5ec49f3e4e9001c8c4a4a"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/contact"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/notFound"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Contact": {
        "$ref": "#/components/schemas/contact"
      },
      "contact": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique identifier of the contact",
            "example": "60d5ec49f3e4e9001c8c4a4a"
          },
          "name": {
            "type": "string",
            "description": "Name of the contact",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the contact",
            "example": "john.doe@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Phone number of the contact",
            "example": "123-456-7890"
          },
          "favorite": {
            "type": "boolean",
            "description": "Indicates if the contact is a favorite",
            "example": false
          },
          "owner": {
            "type": "string",
            "description": "ID of the user who owns the contact",
            "example": "60d5ec49f3e4e9001c8c4a4b"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the contact was created"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the contact was last updated"
          }
        }
      },
      "unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Not authorized"
                }
              }
            }
          }
        }
      },
      "notFound": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Not found"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "$ref": "#/components/responses/notFound"
      },
      "Unauthorized": {
        "$ref": "#/components/responses/unauthorized"
      },
      "unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Not authorized"
                }
              }
            }
          }
        }
      },
      "notFound": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Not found"
                }
              }
            }
          }
        }
      }
    }
  }
}